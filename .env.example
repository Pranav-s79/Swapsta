# Copy to .env.local and fill in locally. Never commit real values.

# xAI (Grok) API key, from https://console.x.ai
# Powers the "Ask Grok to expand this search" feature in the marketplace
# (src/app/api/ai/search/route.ts). Optional: without it, that endpoint
# just returns { enabled: false } and the app falls back to the normal
# rules-based search with no visible change.
XAI_API_KEY=
